import pandas as pd
import numpy as np
from typing import List, Dict, Tuple, Union
from scipy import stats, signal
from sklearn.preprocessing import StandardScaler
import warnings

class TimeSeriesFeatureExtractor:
    def __init__(self, 
                 lag_features: bool = True, 
                 rolling_statistics: bool = True,
                 fourier_features: bool = True,
                 change_features: bool = True):
        """
        Feature extractor for time series data
        
        Args:
            lag_features: Whether to include lagged values as features
            rolling_statistics: Whether to include rolling window statistics
            fourier_features: Whether to include Fourier features for seasonality
            change_features: Whether to include rate of change features
        """
        self.lag_features = lag_features
        self.rolling_statistics = rolling_statistics
        self.fourier_features = fourier_features
        self.change_features = change_features
        self.scaler = StandardScaler()
        
        # Configuration parameters
        self.lag_window_sizes = [1, 3, 6, 12, 24, 48, 72]  # Hours
        self.rolling_window_sizes = [6, 12, 24, 48]  # Hours
        self.fourier_periods = [12, 24, 168]  # Hours (daily, weekly cycles)
        
    def fit_transform(self, df: pd.DataFrame, target_col: str) -> Tuple[pd.DataFrame, pd.Series]:
        """
        Fit the feature extractor and transform the input data
        
        Args:
            df: Input DataFrame with time series data (must have datetime index)
            target_col: Name of the target column to predict
            
        Returns:
            Tuple containing:
            - X: DataFrame with extracted features
            - y: Series with target values
        """
        # Validate input
        if not isinstance(df.index, pd.DatetimeIndex):
            raise ValueError("DataFrame must have a DatetimeIndex")
            
        df_copy = df.copy()
        
        # Extract and remove target variable
        y = df_copy[target_col].copy()
        df_copy = df_copy.drop(columns=[target_col])
        
        # Apply feature extraction
        X = self._extract_features(df_copy)
        
        # Fill missing values from feature creation
        X = X.fillna(method='ffill').fillna(method='bfill')
        
        # Ensure full feature set with no missing values
        if X.isna().any().any():
            warnings.warn("Some features still contain NaN values after filling. These will be filled with 0.")
            X = X.fillna(0)
        
        # Scale features
        X_scaled = pd.DataFrame(
            self.scaler.fit_transform(X),
            index=X.index,
            columns=X.columns
        )
        
        return X_scaled, y
    
    def transform(self, df: pd.DataFrame, target_col: str = None) -> Union[pd.DataFrame, Tuple[pd.DataFrame, pd.Series]]:
        """
        Transform new data using the fitted feature extractor
        
        Args:
            df: Input DataFrame with time series data
            target_col: Optional name of the target column
            
        Returns:
            If target_col is provided:
                Tuple containing:
                - X: DataFrame with extracted features
                - y: Series with target values
            Otherwise:
                X: DataFrame with extracted features
        """
        df_copy = df.copy()
        
        # Extract target if provided
        y = None
        if target_col is not None and target_col in df_copy.columns:
            y = df_copy[target_col].copy()
            df_copy = df_copy.drop(columns=[target_col])
        
        # Apply feature extraction
        X = self._extract_features(df_copy)
        
        # Fill missing values
        X = X.fillna(method='ffill').fillna(method='bfill').fillna(0)
        
        # Scale features using pre-fit scaler
        X_scaled = pd.DataFrame(
            self.scaler.transform(X),
            index=X.index,
            columns=X.columns
        )
        
        if y is not None:
            return X_scaled, y
        else:
            return X_scaled
    
    def _extract_features(self, df: pd.DataFrame) -> pd.DataFrame:
        """Extract all configured features from the input data"""
        features = df.copy()
        
        # Create lag features
        if self.lag_features:
            for col in df.columns:
                for lag in self.lag_window_sizes:
                    features[f'{col}_lag_{lag}'] = df[col].shift(lag)
        
        # Create rolling statistics features
        if self.rolling_statistics:
            for col in df.columns:
                for window in self.rolling_window_sizes:
                    features[f'{col}_rolling_mean_{window}'] = df[col].rolling(window=window).mean()
                    features[f'{col}_rolling_std_{window}'] = df[col].rolling(window=window).std()
                    features[f'{col}_rolling_min_{window}'] = df[col].rolling(window=window).min()
                    features[f'{col}_rolling_max_{window}'] = df[col].rolling(window=window).max()
        
        # Create Fourier features for seasonality
        if self.fourier_features:
            for col in df.columns:
                for period in self.fourier_periods:
                    # Assume evenly spaced time series
                    t = np.arange(len(df))
                    features[f'{col}_sin_{period}'] = np.sin(2 * np.pi * t / period)
                    features[f'{col}_cos_{period}'] = np.cos(2 * np.pi * t / period)
        
        # Create rate of change features
        if self.change_features:
            for col in df.columns:
                # First derivative (rate of change)
                features[f'{col}_diff'] = df[col].diff()
                # Second derivative (acceleration)
                features[f'{col}_diff2'] = df[col].diff().diff()
                # Percentage change
                features[f'{col}_pct_change'] = df[col].pct_change()
        
        return features
