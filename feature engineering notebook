# Example notebook structure for feature_engineering.ipynb

# Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from src.feature_engineering import TimeSeriesFeatureExtractor

# Load sample sensor data
# This would be your actual data loading code
data = pd.read_csv('data/equipment_sensor_data.csv', parse_dates=['timestamp'])
data.set_index('timestamp', inplace=True)

# Display basic information about the dataset
print(f"Dataset shape: {data.shape}")
print(f"Time range: {data.index.min()} to {data.index.max()}")
print(f"Columns: {data.columns.tolist()}")

# Visualize raw sensor data
plt.figure(figsize=(14, 8))
for column in data.columns[:5]:  # First 5 sensors
    plt.plot(data.index, data[column], label=column)
plt.legend()
plt.title('Raw Sensor Readings')
plt.xlabel('Time')
plt.ylabel('Sensor Value')
plt.show()

# Create feature extractor
feature_extractor = TimeSeriesFeatureExtractor(
    lag_features=True,
    rolling_statistics=True,
    fourier_features=True,
    change_features=True
)

# Extract features and target
X, y = feature_extractor.fit_transform(data, target_col='failure_indicator')

# Examine created features
print(f"Features shape: {X.shape}")
print(f"Feature names: {X.columns.tolist()[:10]}...")  # First 10 features

# Analyze feature importance
# Here you would use a model like Random Forest to get feature importance
# For demonstration, let's create a correlation plot with the target
correlation = pd.concat([X, y], axis=1).corr()['failure_indicator'].sort_values(ascending=False)
top_features = correlation.iloc[1:11]  # Top 10 features excluding target itself

plt.figure(figsize=(10, 6))
top_features.plot(kind='bar')
plt.title('Top 10 Features by Correlation with Failure')
plt.ylabel('Correlation Coefficient')
plt.tight_layout()
plt.show()

# Time-based feature importance
# Create a heatmap showing how feature importance varies over time before failure
# This would require additional code to segment the data by time-to-failure

# Feature stability analysis
plt.figure(figsize=(14, 8))
# Plot a few key features over time
for feature in X.columns[:5]:
    plt.plot(X.index, X[feature], label=feature)
plt.legend()
plt.title('Key Engineered Features Over Time')
plt.xlabel('Time')
plt.ylabel('Standardized Feature Value')
plt.show()

# Save processed features for model training
X.to_csv('data/processed/engineered_features.csv')
y.to_csv('data/processed/target_variable.csv')

print("Feature engineering complete!")
